{
    "name": "phattarachai/thai-id-card-validation",
    "description": "Validate Thai national ID card numbers (เลขบัตรประชาชน) in Laravel and PHP",
    "type": "library",
    "license": "MIT",
    "homepage": "https://phattarachai.dev",
    "keywords": [
        "laravel",
        "thai",
        "validation",
        "id-card"
    ],
    "authors": [
        {
            "name": "Phattarachai Chaimongkol",
            "email": "phatchai28@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.8|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Phattarachai\\ThaiIdCardValidation\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phattarachai\\ThaiIdCardValidation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy": {
            "cooldown": {
                "period": "1 day",
                "ignore": {
                    "phattarachai/*": "Our own packages, released by us"
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
